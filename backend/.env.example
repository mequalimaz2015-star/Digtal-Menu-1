# ─────────────────────────────────────────────────────────────────────────────
# Digital Menu SaaS — Environment Variables
# Copy this file to .env and fill in your values.
# AletCloud injects these as environment variables directly — no .env file needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Use a strong random string in production (min 32 chars)
JWT_SECRET=replace-with-strong-random-secret-min-32-chars

# ── Database — MySQL (AletCloud) ──────────────────────────────────────────────
# Full connection string (used by mysql2)
DATABASE_URL=mysql://admin_digtal_menu:YOUR_PASSWORD@digital-menu.db-836.svc.cluster.local:3306/digtal_menu

# Driver selector — must be "mysql" for AletCloud
DB_CONNECTION=mysql

# Individual connection params (used as fallback if DATABASE_URL not set)
DB_HOST=digital-menu.db-836.svc.cluster.local
DB_PORT=3306
DB_DATABASE=digtal_menu
DB_NAME=digtal_menu
DB_USERNAME=admin_digtal_menu
DB_USER=admin_digtal_menu
DB_PASSWORD=YOUR_PASSWORD

# mysql2-specific vars (same values, different key names)
MYSQL_HOST=digital-menu.db-836.svc.cluster.local
MYSQL_PORT=3306
MYSQL_DATABASE=digtal_menu
MYSQL_USER=admin_digtal_menu
MYSQL_PASSWORD=YOUR_PASSWORD

# ── Spring / JDBC (if used by any Java service alongside Node) ────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://digital-menu.db-836.svc.cluster.local:3306/digtal_menu
SPRING_DATASOURCE_USERNAME=admin_digtal_menu
SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
