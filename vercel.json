{
  "services": {
    "web": {
      "root": "frontend/"
    }
  },
  "rewrites": [
    {
      "source": "/((?!.*\\..*$).*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
